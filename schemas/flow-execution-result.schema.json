{
  "$id": "https://schemas.aivideofactory.com/v1/flow-execution-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AVF FlowExecutionPort Result Schema",
  "description": "Standardized execution response envelope for FlowExecutionPort operations.",
  "type": "object",
  "required": [
    "command_id",
    "session_id",
    "command_type",
    "status",
    "timestamp_utc"
  ],
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "command_type": {
      "type": "string",
      "enum": [
        "ENSURE_SESSION",
        "OPEN_FLOW",
        "CREATE_OR_SELECT_PROJECT",
        "ATTACH_ASSETS",
        "SET_GENERATION_OPTIONS",
        "SUBMIT_PROMPT",
        "READ_GENERATION_STATE",
        "DOWNLOAD_OUTPUT",
        "CAPTURE_DIAGNOSTIC",
        "CANCEL"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED",
        "PENDING",
        "RUNNING"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "result": {
      "type": "object",
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retry_category"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "PROVIDER_RATE_LIMIT",
            "AUTH_REQUIRED",
            "SECURITY_CHALLENGE",
            "UI_CHANGED",
            "BUDGET_EXHAUSTED",
            "UNSUPPORTED_CAPABILITY",
            "NETWORK_TIMEOUT",
            "BAD_REQUEST",
            "PROVIDER_INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string"
        },
        "retry_category": {
          "type": "string",
          "enum": [
            "TRANSIENT",
            "PERMANENT",
            "POLICY_BLOCKED",
            "RESOURCE_EXHAUSTED"
          ]
        },
        "suggested_backoff_ms": {
          "type": "integer",
          "minimum": 0
        },
        "raw_details": {
          "type": "object"
        }
      }
    }
  }
}
